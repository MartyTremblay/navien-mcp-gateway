# Copy to .env and fill in. Never commit .env.
# Production: put these in the service's environment file and set GATEWAY_ENV_FILE= (empty)
# so the gateway reads no .env file at all.

# Authorization server (Keycloak realm) and this gateway's canonical MCP URL
GATEWAY_ISSUER=https://auth.lab.<domain>/realms/home
GATEWAY_RESOURCE_URL=https://boiler.lab.<domain>/mcp
GATEWAY_TOKEN_ALGORITHMS=["RS256"]
GATEWAY_JWKS_CACHE_SECONDS=300

# Transport: localhost by default; the deployed container listens on its lab address
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_ALLOWED_ORIGINS=[]
GATEWAY_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*"]

# Writes (ADR 0008): keep false until deliberately enabled
GATEWAY_WRITES_ENABLED=false

# Audit store (SQLite)
GATEWAY_AUDIT_DB=data/audit.sqlite

# Device: ESPHome native API (Noise-encrypted). The key is a secret.
ESPHOME_HOST=
ESPHOME_PORT=6053
ESPHOME_NOISE_PSK=
